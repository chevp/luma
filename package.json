{
  "name": "luma",
  "version": "0.6.1",
  "private": true,
  "description": "Personal developer CLI — extended sibling of chi",
  "type": "module",
  "bin": {
    "luma": "bin/luma"
  },
  "files": [
    "bin",
    "dist",
    "scripts",
    "context/prototypes/ux-console",
    "context/prototypes/ux-console-v2",
    "context/prototypes/ux-console-v3"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "node -e \"\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
