{
  "name": "luma",
  "version": "0.1.0",
  "private": true,
  "description": "Personal developer CLI — extended sibling of chi",
  "type": "module",
  "bin": {
    "luma": "bin/luma"
  },
  "files": [
    "bin",
    "dist",
    ".che",
    "scripts",
    "context/prototypes/ux-console",
    "context/prototypes/ux-console-v2",
    "context/prototypes/ux-console-v3"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "node -e \"\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "xstate": "^5.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
